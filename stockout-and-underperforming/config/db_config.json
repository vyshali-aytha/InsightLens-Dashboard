{
  "database": {
    "host": "localhost",
    "port": 5432,
    "dbname": "bbi",
    "user": "postgres",
    "password": ""
  },
  "schema": "insightlens",
  "paths": {
    "landing": "data",
    "validation_success": "validation_success",
    "validation_failed": "validation_failed",
    "br_success": "validation_success/br_success",
    "br_failed": "validation_success/br_failed",
    "br_processed": "validation_success/br_processed",
