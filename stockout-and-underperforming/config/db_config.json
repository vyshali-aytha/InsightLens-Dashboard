    "INVENTORY": ["inventory_id", "product_id", "store_id", "date", "stock_capacity", "reorder_level", "available_stock", "inventory_status"],
    "RETURNS": ["return_id", "transaction_id", "customer_id", "product_id", "return_date", "return_qty", "return_amount", "reason", "return_status"],
    "PAYMENTS": ["payment_id", "transaction_id", "store_id", "customer_id", "payment_method", "payment_provider", "payment_status", "amount", "is_active"],
    "CUSTOMER": ["customer_id", "customer_name", "city", "segment", "gender", "mobile", "email", "join_date"]
